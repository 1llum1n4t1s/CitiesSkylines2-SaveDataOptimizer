<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ゲームに読み込ませる mod 本体。ゲームの Cities2_Data\Managed にある DLL を参照してビルドする。
    ビルド: dotnet build -c Release -p:GameManaged=<Managed フォルダー（またはそのコピー）>
    出力の CityCheckup.dll と UI の CityCheckup.mjs を
    %LocalLow%\Colossal Order\Cities Skylines II\Mods\CityCheckup\ に置くと読み込まれる。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CityCheckup</AssemblyName>
    <RootNamespace>CityCheckup</RootNamespace>
    <!-- ゲームの mscorlib / netstandard をそのまま参照する（Unity Mono と同じ型を使うため）。 -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\size-investigation\ref</GameManaged>
    <UiDist>$(MSBuildThisFileDirectory)..\..\ui\dist</UiDist>
  </PropertyGroup>

  <!-- Core はソースごと取り込む（配布する DLL を 1 つにするため）。 -->
  <ItemGroup>
    <Compile Include="..\CityCheckup.Core\**\*.cs" Exclude="..\CityCheckup.Core\obj\**;..\CityCheckup.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameManaged)\mscorlib.dll" Private="false" />
    <Reference Include="$(GameManaged)\netstandard.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\Game.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Burst.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <!-- 動作確認用の画面保存（debug-report の目印があるときだけ使う）。 -->
    <Reference Include="$(GameManaged)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Mathematics.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Collections.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Logging.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.IO.AssetDatabase.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.UI.Binding.dll" Private="false" />
    <!-- ゲームの言語設定（activeLocaleId）を読んで、パネルを日本語／英語で出し分けるため。 -->
    <Reference Include="$(GameManaged)\Colossal.Localization.dll" Private="false" />
  </ItemGroup>

  <!-- UI（Bun でビルドした .mjs）があれば DLL と同じ出力先へ置く。 -->
  <Target Name="CopyUiModule" AfterTargets="Build" Condition="Exists('$(UiDist)\CityCheckup.mjs')">
    <Copy SourceFiles="$(UiDist)\CityCheckup.mjs" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
